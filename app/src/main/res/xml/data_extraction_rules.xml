<?xml version="1.0" encoding="utf-8"?>
<!-- النسخ الاحتياطي والنقل لجوال جديد (أندرويد 12 وأحدث).
     ملف الـ PIN ما بيطلع من الجوال. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="daftari_pin.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="daftari_pin.xml" />
    </device-transfer>
</data-extraction-rules>
