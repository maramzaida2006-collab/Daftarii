<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- الثيم الأساسي. DayNight: بياخد ألوانه من values أو values-night تلقائياً،
         فما في داعي لملف themes تاني لليلي. -->
    <style name="Base.Theme.Supermarket" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/violet</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/lavender</item>
        <item name="colorOnPrimaryContainer">@color/plum</item>
        <item name="colorSecondary">@color/plum</item>
        <item name="colorOnSecondary">@color/on_plum</item>
        <item name="colorSecondaryContainer">@color/lavender</item>
        <item name="colorOnSecondaryContainer">@color/plum</item>

        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/error</item>

        <!-- الخطوط: Readex Pro للنصوص، Alexandria للعناوين -->
        <item name="android:fontFamily">@font/readex_pro</item>
        <item name="fontFamily">@font/readex_pro</item>
        <item name="android:textViewStyle">@style/Daftari.TextView</item>
        <item name="textAppearanceDisplayLarge">@style/Daftari.TA.Display.Large</item>
        <item name="textAppearanceDisplayMedium">@style/Daftari.TA.Display.Medium</item>
        <item name="textAppearanceDisplaySmall">@style/Daftari.TA.Display.Small</item>
        <item name="textAppearanceHeadlineLarge">@style/Daftari.TA.Headline.Large</item>
        <item name="textAppearanceHeadlineMedium">@style/Daftari.TA.Headline.Medium</item>
        <item name="textAppearanceHeadlineSmall">@style/Daftari.TA.Headline.Small</item>
        <item name="textAppearanceTitleLarge">@style/Daftari.TA.Title.Large</item>
        <item name="textAppearanceTitleMedium">@style/Daftari.TA.Title.Medium</item>
        <item name="textAppearanceTitleSmall">@style/Daftari.TA.Title.Small</item>
        <item name="textAppearanceBodyLarge">@style/Daftari.TA.Body.Large</item>
        <item name="textAppearanceBodyMedium">@style/Daftari.TA.Body.Medium</item>
        <item name="textAppearanceBodySmall">@style/Daftari.TA.Body.Small</item>
        <item name="textAppearanceLabelLarge">@style/Daftari.TA.Label.Large</item>
        <item name="textAppearanceLabelMedium">@style/Daftari.TA.Label.Medium</item>
        <item name="textAppearanceLabelSmall">@style/Daftari.TA.Label.Small</item>

        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">@bool/light_system_bars</item>
    </style>

    <style name="Theme.Supermarket" parent="Base.Theme.Supermarket" />

    <!-- شاشة البداية: كلها plum، والشريط فوق وتحت بنفس اللون. -->
    <style name="Base.Theme.Daftari.Splash" parent="Theme.Supermarket">
        <item name="android:windowBackground">@color/plum</item>
        <item name="android:statusBarColor">@color/plum</item>
        <item name="android:navigationBarColor">@color/plum</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <!-- بأندرويد 12 وأحدث في نسخة بـ values-v31 بتلوّن شاشة النظام كمان. -->
    <style name="Theme.Daftari.Splash" parent="Base.Theme.Daftari.Splash" />

    <!-- شاشات كلها plum غير البداية (متل شاشة القفل). -->
    <style name="Theme.Daftari.Plum" parent="Base.Theme.Daftari.Splash" />
</resources>
