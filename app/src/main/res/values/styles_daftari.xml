<?xml version="1.0" encoding="utf-8"?>
<!-- ستايلات مشتركة من التصميم. استخدموها بكل الشاشات بدل ما تكتبوا الألوان والأحجام بكل layout. -->
<resources>

    <!-- العنوان الكبير بأول الشاشة (26sp) -->
    <style name="Daftari.Text.Title" parent="">
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">@font/alexandria_semibold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>


    <!-- النص الفرعي تحت العنوان -->
    <style name="Daftari.Text.Subtitle" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <!-- اسم الحقل فوق الخانة -->
    <style name="Daftari.Text.Label" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/readex_pro_medium</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <!-- خانة إدخال: بيضا، زوايا 18، أيقونة على البداية -->
    <style name="Daftari.Field" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="hintEnabled">false</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxStrokeColor">@color/violet</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxCornerRadiusTopStart">18dp</item>
        <item name="boxCornerRadiusTopEnd">18dp</item>
        <item name="boxCornerRadiusBottomStart">18dp</item>
        <item name="boxCornerRadiusBottomEnd">18dp</item>
        <item name="startIconTint">@color/text_secondary</item>
        <item name="endIconTint">@color/text_secondary</item>
    </style>

    <style name="Daftari.FieldInput" parent="">
        <item name="android:minHeight">54dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/readex_pro_regular</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>

    <!-- الزر الأساسي: plum، 56dp، زوايا 20 -->
    <style name="Daftari.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/plum</item>
        <item name="android:textColor">@color/on_plum</item>
        <item name="iconTint">@color/lavender</item>
        <item name="iconGravity">textStart</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/readex_pro_semibold</item>
        <item name="android:elevation">4dp</item>
    </style>

    <!-- الزر الثانوي: أبيض بإطار -->
    <style name="Daftari.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/surface</item>
        <item name="strokeColor">@color/outline</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="iconTint">@color/text_primary</item>
        <item name="iconGravity">textStart</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/readex_pro_medium</item>
    </style>

    <!-- رابط: نص بنفسجي بدون خلفية -->
    <style name="Daftari.Button.Link" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/violet</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/readex_pro_medium</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <!-- زر صغير على هيدر plum (متل زر تغيير اللغة) -->
    <style name="Daftari.Button.HeaderChip" parent="Widget.Material3.Button.TextButton">
        <item name="backgroundTint">@color/lavender_chip</item>
        <item name="android:textColor">@color/on_plum</item>
        <item name="iconTint">@color/lavender</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">6dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/readex_pro_medium</item>
    </style>

    <!-- زر الرجوع الدائري الأبيض (46dp) -->
    <style name="Daftari.BackButton" parent="">
        <item name="android:layout_width">46dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:background">@drawable/shape_circle</item>
        <item name="android:backgroundTint">@color/surface</item>
        <item name="android:src">@drawable/ic_back</item>
        <item name="android:padding">12dp</item>
        <item name="android:elevation">2dp</item>
        <item name="tint">@color/text_primary</item>
        <item name="android:contentDescription">@string/auth_back</item>
    </style>

    <!-- ===== الخطوط ===== -->
    <!-- كل TextView بالتطبيق بياخد Readex Pro تلقائياً -->
    <style name="Daftari.TextView" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/readex_pro</item>
    </style>

    <!-- مقاسات Material 3 بخطوطنا: العناوين Alexandria، والباقي Readex Pro.
         هيك الأزرار والحوارات والقوائم كمان بتاخد الخط الصح. -->
    <style name="Daftari.TA.Display.Large" parent="TextAppearance.Material3.DisplayLarge"><item name="fontFamily">@font/alexandria_semibold</item><item name="android:fontFamily">@font/alexandria_semibold</item></style>
    <style name="Daftari.TA.Display.Medium" parent="TextAppearance.Material3.DisplayMedium"><item name="fontFamily">@font/alexandria_semibold</item><item name="android:fontFamily">@font/alexandria_semibold</item></style>
    <style name="Daftari.TA.Display.Small" parent="TextAppearance.Material3.DisplaySmall"><item name="fontFamily">@font/alexandria_semibold</item><item name="android:fontFamily">@font/alexandria_semibold</item></style>
    <style name="Daftari.TA.Headline.Large" parent="TextAppearance.Material3.HeadlineLarge"><item name="fontFamily">@font/alexandria_semibold</item><item name="android:fontFamily">@font/alexandria_semibold</item></style>
    <style name="Daftari.TA.Headline.Medium" parent="TextAppearance.Material3.HeadlineMedium"><item name="fontFamily">@font/alexandria_semibold</item><item name="android:fontFamily">@font/alexandria_semibold</item></style>
    <style name="Daftari.TA.Headline.Small" parent="TextAppearance.Material3.HeadlineSmall"><item name="fontFamily">@font/alexandria_semibold</item><item name="android:fontFamily">@font/alexandria_semibold</item></style>
    <style name="Daftari.TA.Title.Large" parent="TextAppearance.Material3.TitleLarge"><item name="fontFamily">@font/alexandria_medium</item><item name="android:fontFamily">@font/alexandria_medium</item></style>
    <style name="Daftari.TA.Title.Medium" parent="TextAppearance.Material3.TitleMedium"><item name="fontFamily">@font/readex_pro_semibold</item><item name="android:fontFamily">@font/readex_pro_semibold</item></style>
    <style name="Daftari.TA.Title.Small" parent="TextAppearance.Material3.TitleSmall"><item name="fontFamily">@font/readex_pro_medium</item><item name="android:fontFamily">@font/readex_pro_medium</item></style>
    <style name="Daftari.TA.Body.Large" parent="TextAppearance.Material3.BodyLarge"><item name="fontFamily">@font/readex_pro_regular</item><item name="android:fontFamily">@font/readex_pro_regular</item></style>
    <style name="Daftari.TA.Body.Medium" parent="TextAppearance.Material3.BodyMedium"><item name="fontFamily">@font/readex_pro_regular</item><item name="android:fontFamily">@font/readex_pro_regular</item></style>
    <style name="Daftari.TA.Body.Small" parent="TextAppearance.Material3.BodySmall"><item name="fontFamily">@font/readex_pro_regular</item><item name="android:fontFamily">@font/readex_pro_regular</item></style>
    <style name="Daftari.TA.Label.Large" parent="TextAppearance.Material3.LabelLarge"><item name="fontFamily">@font/readex_pro_medium</item><item name="android:fontFamily">@font/readex_pro_medium</item></style>
    <style name="Daftari.TA.Label.Medium" parent="TextAppearance.Material3.LabelMedium"><item name="fontFamily">@font/readex_pro_medium</item><item name="android:fontFamily">@font/readex_pro_medium</item></style>
    <style name="Daftari.TA.Label.Small" parent="TextAppearance.Material3.LabelSmall"><item name="fontFamily">@font/readex_pro_medium</item><item name="android:fontFamily">@font/readex_pro_medium</item></style>

    <!-- للأرقام والمبالغ الكبيرة (الرصيد، الإجمالي) -->
    <style name="Daftari.Text.Amount" parent="">
        <item name="android:fontFamily">@font/alexandria_semibold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">28sp</item>
    </style>

</resources>
