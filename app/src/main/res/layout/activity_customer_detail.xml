<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/customerDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:layoutDirection="rtl">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollCustomerDetail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp">

            <!-- 1. الشريط العلوي: رجوع، كشف الحساب، قائمة -->
            <LinearLayout
                android:id="@+id/topBarCustomerDetail"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/btnBackCustomerDetail"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:clickable="true"
                    android:contentDescription="@string/action_back"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/btnBack"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:rotation="180"
                        android:src="@drawable/ic_back"
                        app:tint="@color/text_primary" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvCustomerDetailTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/alexandria_semibold"
                    android:gravity="center"
                    android:text="@string/customer_statement_title"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp" />

                <FrameLayout
                    android:id="@+id/btnCustomerMoreOptions"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:clickable="true"
                    android:contentDescription="@string/action_more_options"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/more"
                        app:tint="@color/text_primary" />
                </FrameLayout>
            </LinearLayout>

            <!-- 2. معلومات الزبون وحالة التأخير -->
            <LinearLayout
                android:id="@+id/customerInfoHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/flCustomerDetailAvatar"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/shape_circle"
                    android:backgroundTint="@color/debt_bg">

                    <TextView
                        android:id="@+id/tvCustomerDetailInitials"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/alexandria_semibold"
                        android:text="@string/sample_customer_initials_ak"
                        android:textColor="@color/debt_fg"
                        android:textSize="16sp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDetailCustomerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/alexandria_semibold"
                        android:maxLines="1"
                        android:text="@string/sample_customer_ahmad"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvDetailCustomerPhone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="@font/readex_pro_regular"
                        android:text="@string/sample_customer_phone"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/badgeCustomerOverdue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_r16"
                    android:backgroundTint="@color/debt_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/shape_circle"
                        android:backgroundTint="@color/debt_fg" />

                    <TextView
                        android:id="@+id/tvCustomerOverdueStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/readex_pro_medium"
                        android:maxLines="1"
                        android:text="@string/sample_overdue_5_days"
                        android:textColor="@color/debt_fg"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. بطاقة الرصيد المستحق وأزرار التواصل السريع -->
            <LinearLayout
                android:id="@+id/cardBalanceSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_r26"
                android:backgroundTint="@color/plum"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvDueBalanceLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/readex_pro_regular"
                    android:text="@string/due_balance_label"
                    android:textColor="@color/on_plum_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvDetailTotalDebt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/alexandria_semibold"
                    android:text="@string/sample_detail_due_amount"
                    android:textColor="@color/on_plum"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/tvDueDateAndLastPayment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/readex_pro_regular"
                    android:text="@string/sample_due_and_last_payment"
                    android:textColor="@color/on_plum_secondary"
                    android:textSize="11sp" />

                <LinearLayout
                    android:id="@+id/quickContactRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/btnCallCustomer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/shape_circle"
                            android:backgroundTint="@color/lavender_chip">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@android:drawable/ic_menu_call"
                                app:tint="@color/on_plum" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/readex_pro_regular"
                            android:text="@string/action_call"
                            android:textColor="@color/on_plum_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnWhatsappCustomer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/shape_circle"
                            android:backgroundTint="@color/lavender_chip">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@android:drawable/sym_action_chat"
                                app:tint="@color/on_plum" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/readex_pro_regular"
                            android:text="@string/action_whatsapp"
                            android:textColor="@color/on_plum_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnExportCustomerPdf"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/shape_circle"
                            android:backgroundTint="@color/lavender_chip">

                            <ImageView
                                android:id="@+id/btnDownloadPdf"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@android:drawable/ic_menu_save"
                                app:tint="@color/on_plum" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/readex_pro_regular"
                            android:text="@string/action_statement_pdf"
                            android:textColor="@color/on_plum_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnDueDateReminder"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/shape_circle"
                            android:backgroundTint="@color/lavender_chip">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@android:drawable/ic_menu_my_calendar"
                                app:tint="@color/on_plum" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/readex_pro_regular"
                            android:text="@string/action_due_date"
                            android:textColor="@color/on_plum_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 4. زرا دين جديد وتسجيل دفعة -->
            <LinearLayout
                android:id="@+id/detailPrimaryActionsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnAddDebtItem"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/shape_r18"
                    android:backgroundTint="@color/debt_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/alexandria_semibold"
                        android:text="@string/action_new_debt"
                        android:textColor="@color/debt_fg"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/alexandria_semibold"
                        android:text="+"
                        android:textColor="@color/debt_fg"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnPayDebt"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/shape_r18"
                    android:backgroundTint="@color/payment_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/alexandria_semibold"
                        android:text="@string/action_record_payment"
                        android:textColor="@color/payment_fg"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/alexandria_semibold"
                        android:text="-"
                        android:textColor="@color/payment_fg"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 5. حقول إدخال المبلغ والصنف عند الحاجة -->
            <LinearLayout
                android:id="@+id/inputFieldsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_amount"
                        android:inputType="numberDecimal"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1.5">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etItemName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_item_name"
                        android:inputType="text"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- 6. تبويبات التصفية: الكل / الديون / الدفعات -->
            <LinearLayout
                android:id="@+id/filterTabsContainer"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/shape_r18"
                android:backgroundTint="@color/surface"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/tabFilterAll"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/shape_r16"
                    android:backgroundTint="@color/background"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/readex_pro_semibold"
                    android:gravity="center"
                    android:text="@string/filter_all"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tabFilterDebts"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/readex_pro_medium"
                    android:gravity="center"
                    android:text="@string/filter_debts"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tabFilterPayments"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/readex_pro_medium"
                    android:gravity="center"
                    android:text="@string/filter_payments"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 7. بطاقة سجل الحركات والقائمة الديناميكية -->
            <LinearLayout
                android:id="@+id/cardTransactionsHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/shape_r24"
                android:backgroundTint="@color/surface"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:fontFamily="@font/readex_pro_medium"
                    android:text="@string/history_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewDebts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_debt" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>