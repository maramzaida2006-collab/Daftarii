<?xml version="1.0" encoding="utf-8"?>
<!-- شاشة "فعّل بريدك". حسب تصميم VerifyEmail. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:layoutDirection="rtl"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="22dp"
        android:paddingEnd="28dp"
        android:paddingBottom="32dp">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Daftari.BackButton"
            android:layout_gravity="start" />

        <!-- الدوائر والأيقونة -->
        <FrameLayout
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:layout_marginTop="30dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/shape_circle"
                android:backgroundTint="@color/lavender_soft" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="26dp"
                android:background="@drawable/shape_circle"
                android:backgroundTint="@color/lavender_soft_2" />

            <ImageView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_gravity="center"
                android:background="@drawable/shape_r26"
                android:backgroundTint="@color/plum"
                android:importantForAccessibility="no"
                android:padding="20dp"
                android:src="@drawable/ic_mail"
                app:tint="@color/lavender" />
        </FrameLayout>

        <TextView
            style="@style/Daftari.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/verify_title"
            android:textSize="24sp" />

        <TextView
            style="@style/Daftari.Text.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/verify_sent_to"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_primary"
            android:textDirection="ltr"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Daftari.Text.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="@string/verify_instructions"
            android:textSize="15sp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinue"
            style="@style/Daftari.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/verify_continue"
            app:icon="@drawable/ic_check" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressVerify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/violet"
            app:trackCornerRadius="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenMail"
            style="@style/Daftari.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/verify_open_mail"
            app:icon="@drawable/ic_mail" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/verify_not_received"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResend"
                style="@style/Daftari.Button.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/verify_resend"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChangeEmail"
            style="@style/Daftari.Button.Link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/verify_change_email" />
    </LinearLayout>
</ScrollView>
