<?xml version="1.0" encoding="utf-8"?>
<!-- صفحة الترحيب التانية: "تذكير بالموعد وكشف حساب بضغطة". حسب تصميم Onboarding2. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- الرسمة: دوائر بالخلفية وبطاقات أمثلة فوقها (أوصاف للعرض بس، مش بيانات حقيقية) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:importantForAccessibility="noHideDescendants">

        <FrameLayout
            android:layout_width="330dp"
            android:layout_height="330dp"
            android:layout_gravity="center">

            <View
                android:layout_width="330dp"
                android:layout_height="330dp"
                android:background="@drawable/shape_circle"
                android:backgroundTint="@color/lavender_soft" />

            <View
                android:layout_width="230dp"
                android:layout_height="230dp"
                android:layout_gravity="center"
                android:background="@drawable/shape_circle"
                android:backgroundTint="@color/lavender_soft_2" />

            <View
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="top|start"
                android:background="@drawable/shape_circle"
                android:backgroundTint="@color/debt_bg" />

            <View
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/shape_circle"
                android:backgroundTint="@color/payment_bg" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <!-- إشعار موعد سداد -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_r18"
                android:backgroundTint="@color/surface"
                android:elevation="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/shape_r12"
                    android:backgroundTint="@color/due_bg">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_bell"
                        app:tint="@color/due_fg" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/readex_pro_semibold"
                        android:text="@string/onboarding_demo_due_title"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/onboarding_demo_due_body"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- كشف حساب PDF -->
            <LinearLayout
                android:layout_width="190dp"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="12dp"
                android:background="@drawable/shape_r16"
                android:backgroundTint="@color/surface"
                android:elevation="8dp"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/alexandria_semibold"
                        android:text="@string/onboarding_demo_statement"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/shape_pill"
                        android:backgroundTint="@color/debt_bg"
                        android:fontFamily="@font/readex_pro_medium"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="@string/onboarding_demo_pdf"
                        android:textColor="@color/debt_fg"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/shape_r3"
                    android:backgroundTint="@color/outline" />

                <View
                    android:layout_width="120dp"
                    android:layout_height="6dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/shape_r3"
                    android:backgroundTint="@color/outline" />

                <View
                    android:layout_width="138dp"
                    android:layout_height="6dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/shape_r3"
                    android:backgroundTint="@color/outline" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/shape_r8"
                    android:backgroundTint="@color/plum"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/onboarding_demo_due_label"
                        android:textColor="@color/on_plum"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/alexandria_semibold"
                        android:text="@string/onboarding_demo_c1_amount"
                        android:textColor="@color/on_plum"
                        android:textDirection="ltr"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- تمت المشاركة -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="12dp"
                android:background="@drawable/shape_pill"
                android:backgroundTint="@color/payment_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chat"
                    app:tint="@color/payment_fg" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/readex_pro_semibold"
                    android:text="@string/onboarding_demo_shared"
                    android:textColor="@color/payment_fg"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- النص -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="10dp"
        android:paddingEnd="28dp">

        <!-- رقم الصفحة: النقطة الطويلة هي الصفحة الحالية -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="horizontal">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/shape_r3"
                android:backgroundTint="@color/dot_inactive" />
            <View
                android:layout_width="24dp"
                android:layout_height="8dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/shape_r3"
                android:backgroundTint="@color/plum" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/alexandria_semibold"
            android:lineSpacingMultiplier="1.25"
            android:text="@string/onboarding2_title"
            android:textColor="@color/text_primary"
            android:textSize="28sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingMultiplier="1.5"
            android:text="@string/onboarding2_body"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
