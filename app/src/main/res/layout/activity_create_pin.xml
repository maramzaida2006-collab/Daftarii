<?xml version="1.0" encoding="utf-8"?>
<!-- إنشاء رمز الدخول (PIN) بخطوتين، ومعه خيار البصمة. حسب تصميم CreatePin. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- الهيدر: رجوع وخطوة كم -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingTop="22dp"
        android:paddingEnd="22dp">

        <ImageButton
            android:id="@+id/btnPinBack"
            style="@style/Daftari.BackButton" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvPinStep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- ScrollView عشان الجوالات الصغيرة -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="26dp"
        android:paddingEnd="24dp"
        android:paddingBottom="34dp">

        <!-- الأيقونة والعنوان -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/shape_r24"
            android:backgroundTint="@color/lavender_soft">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_shield"
                app:tint="@color/violet" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvPinTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:fontFamily="@font/alexandria_semibold"
            android:gravity="center"
            android:text="@string/pin_create_title"
            android:textColor="@color/text_primary"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tvPinSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/pin_create_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- النقاط الأربعة -->
        <LinearLayout
            android:id="@+id/pinDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <View style="@style/Daftari.PinDot" />

            <View style="@style/Daftari.PinDot" />

            <View style="@style/Daftari.PinDot" />

            <View style="@style/Daftari.PinDot" />
        </LinearLayout>

        <!-- خطأ (مثلاً الرمزين مش متطابقين) -->
        <TextView
            android:id="@+id/tvPinError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="assertive"
            android:gravity="center"
            android:minLines="1"
            android:textColor="@color/error"
            android:textSize="13sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <include
            android:id="@+id/pinKeypad"
            layout="@layout/view_pin_keypad_light"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="7dp" />

        <!-- البصمة: بتبيّن بس إذا الجوال فيه بصمة جاهزة -->
        <LinearLayout
            android:id="@+id/cardBiometric"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/shape_r18"
            android:backgroundTint="@color/surface"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/shape_r12"
                android:backgroundTint="@color/lavender_soft">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_fingerprint"
                    app:tint="@color/violet" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/readex_pro_semibold"
                    android:text="@string/pin_biometric_title"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/pin_biometric_subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchBiometric"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/pin_biometric_title"
                app:thumbTint="@color/switch_thumb"
                app:trackDecorationTint="@android:color/transparent"
                app:trackTint="@color/switch_track" />
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
</LinearLayout>
