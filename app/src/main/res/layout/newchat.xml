<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/new_customer_sheet.xml -->
<!-- يعمل كـ Bottom Sheet (BottomSheetDialogFragment) أو كـ layout عادي -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:fillViewport="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:alpha="0.35"
            android:background="@drawable/bg_handle" />

        <!-- العنوان + إلغاء -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:text="زبون جديد"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:padding="4dp"
                android:text="إلغاء"
                android:textColor="@color/violet"
                android:textSize="14sp" />
        </FrameLayout>

        <!-- اسم الزبون -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="اسم الزبون *"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/container"
                    app:tint="@color/text_secondary" />

                <EditText
                    android:id="@+id/etName"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="مثال: أحمد خليل"
                    android:inputType="textPersonName"
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- رقم الجوال -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="رقم الجوال"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/container__1_"
                    app:tint="@color/text_secondary" />

                <EditText
                    android:id="@+id/etPhone"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="05X XXX XXXX"
                    android:inputType="phone"
                    android:layoutDirection="ltr"
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+970"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- موعد السداد -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="موعد السداد"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupDue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipNone"
                style="@style/Widget.App.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:textColor="@color/chip_text_selector"
                android:textSize="13sp"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/chip_bg_selector"
                app:chipCornerRadius="12dp"
                app:chipMinHeight="40dp"
                app:chipStrokeColor="@color/outline"
                app:chipStrokeWidth="1dp"
                app:ensureMinTouchTargetSize="false"
                android:text="بدون" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipWeek"
                style="@style/Widget.App.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:textColor="@color/chip_text_selector"
                android:textSize="13sp"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/chip_bg_selector"
                app:chipCornerRadius="12dp"
                app:chipMinHeight="40dp"
                app:chipStrokeColor="@color/outline"
                app:chipStrokeWidth="1dp"
                app:ensureMinTouchTargetSize="false"
                android:checked="true"
                android:text="أسبوع" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTwoWeeks"
                style="@style/Widget.App.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:textColor="@color/chip_text_selector"
                android:textSize="13sp"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/chip_bg_selector"
                app:chipCornerRadius="12dp"
                app:chipMinHeight="40dp"
                app:chipStrokeColor="@color/outline"
                app:chipStrokeWidth="1dp"
                app:ensureMinTouchTargetSize="false"
                android:text="أسبوعين" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMonth"
                style="@style/Widget.App.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:textColor="@color/chip_text_selector"
                android:textSize="13sp"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/chip_bg_selector"
                app:chipCornerRadius="12dp"
                app:chipMinHeight="40dp"
                app:chipStrokeColor="@color/outline"
                app:chipStrokeWidth="1dp"
                app:ensureMinTouchTargetSize="false"
                android:text="شهر" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCustom"
                style="@style/Widget.App.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:textColor="@color/chip_text_selector"
                android:textSize="13sp"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/chip_bg_selector"
                app:chipCornerRadius="12dp"
                app:chipMinHeight="40dp"
                app:chipStrokeColor="@color/outline"
                app:chipStrokeWidth="1dp"
                app:ensureMinTouchTargetSize="false"
                android:text="تاريخ محدد" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:id="@+id/tvDueHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="يعني 28 نوفمبر 2026 ، بنوصلك إشعار قبلها بيوم"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- أول دين -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="أول دين (اختياري)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- في RTL أول عنصر يطلع يمين: الشارة "دين" -->
                    <TextView
                        android:id="@+id/tvDebtBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_debt"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:text="دين"
                        android:textColor="@color/debt_fg"
                        android:textSize="11sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <EditText
                        android:id="@+id/etAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:hint="0.00"
                        android:inputType="numberDecimal"
                        android:layoutDirection="ltr"
                        android:minWidth="100dp"
                        android:textAlignment="viewEnd"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_primary"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="₪"
                        android:textColor="@color/text_primary"
                        android:textSize="26sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- زر الحفظ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="حفظ الزبون"
            android:textColor="@color/on_plum"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/plum"
            app:cornerRadius="18dp"
            app:elevation="8dp"
            app:icon="@drawable/ic_check"
            app:iconGravity="textStart"
            app:iconTint="@color/on_plum" />
    </LinearLayout>
</ScrollView>