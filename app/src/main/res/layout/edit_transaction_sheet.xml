<?xml version="1.0" encoding="utf-8"?>
<!-- تعديل حركة (Bottom Sheet): المبلغ، أثره على الرصيد، الوصف، سجل التعديلات، أرشفة وحفظ.
     حسب تصميم EditTransaction. الكود بـ EditTransactionSheet. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="12dp"
        android:paddingEnd="22dp"
        android:paddingBottom="30dp">

        <!-- الخط الصغير فوق -->
        <View
            android:layout_width="44dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/shape_r3"
            android:backgroundTint="@color/dot_inactive" />

        <!-- العنوان ونوع الحركة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:fontFamily="@font/alexandria_semibold"
                    android:text="@string/edit_tx_title"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tvEditSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEditType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_pill"
                android:fontFamily="@font/readex_pro_medium"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- المبلغ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/shape_r24"
            android:backgroundTint="@color/surface"
            android:elevation="2dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="14dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/etEditAmount"
                android:text="@string/edit_tx_amount"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layoutDirection="ltr"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:fontFamily="@font/alexandria_semibold"
                    android:importantForAccessibility="no"
                    android:text="₪"
                    android:textColor="@color/text_primary"
                    android:textSize="32sp"
                    tools:ignore="HardcodedText" />

                <EditText
                    android:id="@+id/etEditAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/alexandria_semibold"
                    android:gravity="center"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:maxLength="12"
                    android:minWidth="80dp"
                    android:textColor="@color/text_primary"
                    android:textSize="40sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEditDiff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:accessibilityLiveRegion="polite"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- الوصف -->
        <TextView
            style="@style/Daftari.Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/edit_tx_note" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEditNote"
            style="@style/Daftari.Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:startIconDrawable="@drawable/ic_document">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEditNote"
                style="@style/Daftari.FieldInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLength="200" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- سجل التعديلات -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/shape_r24"
            android:backgroundTint="@color/surface"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/violet" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:accessibilityHeading="true"
                    android:fontFamily="@font/readex_pro_semibold"
                    android:text="@string/edit_tx_history"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- السطور بتنضاف من الكود (item_edit_history) -->
            <LinearLayout
                android:id="@+id/historyContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- أرشفة (ثلث) وحفظ (ثلثين) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditArchive"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/edit_tx_archive"
                android:textColor="@color/debt_fg"
                android:textSize="14sp"
                app:backgroundTint="@color/debt_bg"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_archive"
                app:iconSize="19dp"
                app:iconTint="@color/debt_fg" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditSave"
                style="@style/Daftari.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="@string/edit_tx_save"
                app:icon="@drawable/ic_check"
                app:iconGravity="textStart"
                app:iconTint="@color/lavender" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
