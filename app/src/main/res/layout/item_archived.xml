<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- السطر الأول -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- أيقونة السهم -->
        <FrameLayout
            android:id="@+id/iconBox"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_icon_red">

            <ImageView
                android:id="@+id/ivDirection"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/svg__2_"
                app:tint="#C0392B" />
        </FrameLayout>

        <!-- العنوان + التفاصيل -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="علبة زيت"
                android:textColor="#1A1A1A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="أحمد خليل · أُرشفت اليوم"
                android:textColor="#7A7A7A"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- المبلغ -->
        <TextView
            android:id="@+id/tvAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ ₪ 42.00"
            android:textColor="#C0392B"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- السطر الثاني: الأزرار -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <!-- استرجاع -->
        <LinearLayout
            android:id="@+id/btnRestore"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_restore"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/svg__4_"
                app:tint="#5B3FC4" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="استرجاع"
                android:textColor="#5B3FC4"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- حذف -->
        <FrameLayout
            android:id="@+id/btnDelete"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_delete"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/vector"
                app:tint="#C0392B" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>