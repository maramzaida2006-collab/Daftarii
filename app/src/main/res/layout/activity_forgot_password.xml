<?xml version="1.0" encoding="utf-8"?>
<!-- شاشة "نسيت كلمة السر". حسب تصميم ForgotPassword. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="22dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Daftari.BackButton" />

        <ImageView
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/shape_r24"
            android:backgroundTint="@color/due_bg"
            android:importantForAccessibility="no"
            android:padding="19dp"
            android:src="@drawable/ic_key"
            app:tint="@color/due_fg" />

        <TextView
            style="@style/Daftari.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/forgot_title" />

        <TextView
            style="@style/Daftari.Text.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp"
            android:text="@string/forgot_subtitle"
            android:textSize="15sp" />

        <TextView
            style="@style/Daftari.Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auth_label_email" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilResetEmail"
            style="@style/Daftari.Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:startIconDrawable="@drawable/ic_mail">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etResetEmail"
                style="@style/Daftari.FieldInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/auth_hint_email"
                android:inputType="textEmailAddress"
                android:textDirection="ltr" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendResetLink"
            style="@style/Daftari.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/forgot_send" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressForgot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/violet"
            app:trackCornerRadius="4dp" />

        <!-- بطاقة "تم الإرسال": بتظهر بعد النجاح -->
        <LinearLayout
            android:id="@+id/cardSent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/shape_r18"
            android:backgroundTint="@color/payment_bg"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_check"
                app:tint="@color/payment_fg" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/forgot_sent_title"
                    android:textColor="@color/payment_fg"
                    android:textSize="14sp"
                    android:fontFamily="@font/readex_pro_semibold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:lineSpacingMultiplier="1.3"
                    android:text="@string/forgot_sent_body"
                    android:textColor="@color/payment_fg"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackToLogin"
            style="@style/Daftari.Button.Link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/forgot_back_to_login" />
    </LinearLayout>
</ScrollView>
