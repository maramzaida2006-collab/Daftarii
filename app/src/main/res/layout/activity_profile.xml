<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/profileRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:layoutDirection="rtl">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollProfileContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="110dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp">

            <!-- العنوان العلوي: حسابي -->
            <TextView
                android:id="@+id/tvProfileTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/alexandria_semibold"
                android:text="@string/nav_profile"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <!-- بطاقة بيانات المحل والحساب (Plum Card) -->
            <RelativeLayout
                android:id="@+id/cardAccountSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_r26"
                android:backgroundTint="@color/plum"
                android:padding="16dp">

                <!-- زر التعديل على الطرف -->
                <FrameLayout
                    android:id="@+id/btnEditProfile"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/shape_circle"
                    android:backgroundTint="@color/lavender_chip"
                    android:clickable="true"
                    android:contentDescription="@string/action_edit_profile"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@android:drawable/ic_menu_edit"
                        app:tint="@color/on_plum" />
                </FrameLayout>

                <!-- دائرة الحرف الأول للمحل -->
                <FrameLayout
                    android:id="@+id/flProfileAvatar"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/shape_circle"
                    android:backgroundTint="@color/lavender_chip">

                    <TextView
                        android:id="@+id/tvProfileInitial"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/alexandria_semibold"
                        android:text="@string/home_store_initial"
                        android:textColor="@color/on_plum"
                        android:textSize="19sp" />
                </FrameLayout>

                <!-- اسم المحل والبريد وحالة التفعيل -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_toStartOf="@id/flProfileAvatar"
                    android:layout_toEndOf="@id/btnEditProfile"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvProfileStoreName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/alexandria_semibold"
                        android:maxLines="1"
                        android:text="@string/home_store_name"
                        android:textColor="@color/on_plum"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvProfileEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/readex_pro_regular"
                        android:maxLines="1"
                        android:text="@string/sample_owner_email"
                        android:textColor="@color/on_plum_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvEmailStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/shape_r16"
                        android:backgroundTint="@color/lavender"
                        android:fontFamily="@font/readex_pro_medium"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="@string/email_verified_status"
                        android:textColor="@color/plum"
                        android:textSize="11sp" />
                </LinearLayout>
            </RelativeLayout>

            <!-- قسم الأمان -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/readex_pro_medium"
                android:text="@string/section_security"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/cardSecuritySection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_r24"
                android:backgroundTint="@color/surface"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="2dp">

                <!-- الدخول بالبصمة -->
                <LinearLayout
                    android:id="@+id/rowBiometricLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="46dp"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/shape_circle"
                        android:backgroundTint="@color/lavender_soft">

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@android:drawable/ic_lock_lock"
                            app:tint="@color/violet" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/readex_pro_medium"
                        android:text="@string/security_biometric"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchBiometric"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:checked="true" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/background" />

                <!-- رمز PIN -->
                <LinearLayout
                    android:id="@+id/rowPinCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="46dp"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/shape_circle"
                        android:backgroundTint="@color/lavender_soft">

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@android:drawable/ic_dialog_dialer"
                            app:tint="@color/violet" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/readex_pro_medium"
                        android:text="@string/security_pin"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:rotation="180"
                        android:src="@drawable/Vector"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/background" />

                <!-- كلمة المرور -->
                <LinearLayout
                    android:id="@+id/rowChangePassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="46dp"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/shape_circle"
                        android:backgroundTint="@color/lavender_soft">

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@android:drawable/ic_secure"
                            app:tint="@color/violet" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/readex_pro_medium"
                        android:text="@string/security_password"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:rotation="180"
                        android:src="@drawable/Vector"
                        app:tint="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <!-- قسم البيانات -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/readex_pro_medium"
                android:text="@string/section_data"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/cardDataSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_r24"
                android:backgroundTint="@color/surface"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="2dp">

                <!-- الأرشيف -->
                <LinearLayout
                    android:id="@+id/rowArchive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="46dp"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/shape_circle"
                        android:backgroundTint="@color/due_bg">

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@android:drawable/ic_menu_save"
                            app:tint="@color/due_fg" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/readex_pro_medium"
                        android:text="@string/data_archive"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvArchiveCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:fontFamily="@font/readex_pro_regular"
                        android:text="@string/sample_archive_count"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:rotation="180"
                        android:src="@drawable/Vector"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/background" />

                <!-- تصدير كل الحسابات PDF -->
                <LinearLayout
                    android:id="@+id/rowExportPdf"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="46dp"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/shape_circle"
                        android:backgroundTint="@color/debt_bg">

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@android:drawable/ic_menu_share"
                            app:tint="@color/debt_fg" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/readex_pro_medium"
                        android:text="@string/data_export_pdf"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:rotation="180"
                        android:src="@drawable/Vector"
                        app:tint="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <!-- قسم التطبيق -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/readex_pro_medium"
                android:text="@string/section_app"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/cardAppSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_r24"
                android:backgroundTint="@color/surface"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="2dp">

                <!-- الوضع الليلي -->
                <LinearLayout
                    android:id="@+id/rowDarkMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="46dp"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/shape_circle"
                        android:backgroundTint="@color/lavender_soft">

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@android:drawable/ic_menu_day"
                            app:tint="@color/violet" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/readex_pro_medium"
                        android:text="@string/app_dark_mode"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchDarkMode"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:checked="false" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/background" />

                <!-- إشعارات الجوال -->
                <LinearLayout
                    android:id="@+id/rowPushNotifications"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="46dp"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/shape_circle"
                        android:backgroundTint="@color/lavender_soft">

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@android:drawable/ic_popup_reminder"
                            app:tint="@color/violet" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/readex_pro_medium"
                        android:text="@string/app_notifications"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchNotifications"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:checked="true" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- الشريط السفلي العائم (حسابي نشط) -->
    <LinearLayout
        android:id="@+id/bottomNavFloatingProfile"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/shape_r26"
        android:backgroundTint="@color/plum"
        android:baselineAligned="false"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <!-- الرئيسية -->
        <FrameLayout
            android:id="@+id/navProfileTabHome"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@string/nav_home"
                android:src="@drawable/ic_book"
                app:tint="@color/on_plum_secondary" />
        </FrameLayout>

        <!-- التقارير -->
        <FrameLayout
            android:id="@+id/navProfileTabReports"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@string/nav_reports"
                android:src="@drawable/more"
                app:tint="@color/on_plum_secondary" />
        </FrameLayout>

        <!-- حسابي (نشط) -->
        <LinearLayout
            android:id="@+id/navProfileTabAccount"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.55"
            android:background="@drawable/shape_r26"
            android:backgroundTint="@color/lavender"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_user"
                app:tint="@color/plum" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/readex_pro_semibold"
                android:text="@string/nav_profile"
                android:textColor="@color/plum"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>