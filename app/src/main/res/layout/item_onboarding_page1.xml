<?xml version="1.0" encoding="utf-8"?>
<!-- صفحة الترحيب الأولى: "كل ديون محلّك بمكان واحد". حسب تصميم Onboarding1. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- الرسمة: دوائر بالخلفية وبطاقات أمثلة فوقها (أوصاف للعرض بس، مش بيانات حقيقية) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:importantForAccessibility="noHideDescendants">

        <FrameLayout
            android:layout_width="330dp"
            android:layout_height="330dp"
            android:layout_gravity="center">

            <View
                android:layout_width="330dp"
                android:layout_height="330dp"
                android:background="@drawable/shape_circle"
                android:backgroundTint="@color/lavender_soft" />

            <View
                android:layout_width="230dp"
                android:layout_height="230dp"
                android:layout_gravity="center"
                android:background="@drawable/shape_circle"
                android:backgroundTint="@color/lavender_soft_2" />

            <View
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="top|start"
                android:background="@drawable/shape_circle"
                android:backgroundTint="@color/debt_bg" />

            <View
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/shape_circle"
                android:backgroundTint="@color/payment_bg" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <!-- بطاقة الإجمالي -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_r24"
                android:backgroundTint="@color/plum"
                android:elevation="8dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onboarding_demo_total_label"
                    android:textColor="@color/on_plum_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/alexandria_semibold"
                    android:text="@string/onboarding_demo_total"
                    android:textColor="@color/on_plum"
                    android:textDirection="ltr"
                    android:textSize="26sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/shape_r18"
                android:backgroundTint="@color/surface"
                android:elevation="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/shape_circle"
                    android:backgroundTint="@color/debt_bg"
                    android:fontFamily="@font/alexandria_semibold"
                    android:gravity="center"
                    android:text="@string/onboarding_demo_c1_initials"
                    android:textColor="@color/debt_fg"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/readex_pro_semibold"
                        android:text="@string/onboarding_demo_c1_name"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:background="@drawable/shape_pill"
                        android:backgroundTint="@color/debt_bg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/shape_circle"
                            android:backgroundTint="@color/debt_fg" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:fontFamily="@font/readex_pro_medium"
                            android:text="@string/status_overdue"
                            android:textColor="@color/debt_fg"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/alexandria_semibold"
                    android:text="@string/onboarding_demo_c1_amount"
                    android:textColor="@color/text_primary"
                    android:textDirection="ltr"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginStart="26dp"
                android:background="@drawable/shape_r18"
                android:backgroundTint="@color/surface"
                android:elevation="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/shape_circle"
                    android:backgroundTint="@color/avatar_pink_bg"
                    android:fontFamily="@font/alexandria_semibold"
                    android:gravity="center"
                    android:text="@string/onboarding_demo_c2_initials"
                    android:textColor="@color/avatar_pink_fg"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/readex_pro_semibold"
                        android:text="@string/onboarding_demo_c2_name"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:background="@drawable/shape_pill"
                        android:backgroundTint="@color/payment_bg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/shape_circle"
                            android:backgroundTint="@color/payment_fg" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:fontFamily="@font/readex_pro_medium"
                            android:text="@string/status_regular"
                            android:textColor="@color/payment_fg"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/alexandria_semibold"
                    android:text="@string/onboarding_demo_c2_amount"
                    android:textColor="@color/text_primary"
                    android:textDirection="ltr"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- النص -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="10dp"
        android:paddingEnd="28dp">

        <!-- رقم الصفحة: النقطة الطويلة هي الصفحة الحالية -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="horizontal">

            <View
                android:layout_width="24dp"
                android:layout_height="8dp"
                android:background="@drawable/shape_r3"
                android:backgroundTint="@color/plum" />
            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/shape_r3"
                android:backgroundTint="@color/dot_inactive" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/alexandria_semibold"
            android:lineSpacingMultiplier="1.25"
            android:text="@string/onboarding1_title"
            android:textColor="@color/text_primary"
            android:textSize="28sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingMultiplier="1.5"
            android:text="@string/onboarding1_body"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
