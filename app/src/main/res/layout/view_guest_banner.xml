<?xml version="1.0" encoding="utf-8"?>
<!-- شريط الزائر فوق الرئيسية: "أنت داخل كزائر"، والأيام الضايلة، وزر "إنشاء حساب".
     بيبيّن بس للزائر. الكود بـ GuestBanner. حسب تصميم MainGuest. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/guestBanner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/shape_r18"
    android:backgroundTint="@color/lavender_soft"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp"
    android:visibility="gone">

    <FrameLayout
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/shape_r12"
        android:backgroundTint="@color/surface">

        <ImageView
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_shield"
            app:tint="@color/violet" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/readex_pro_semibold"
            android:text="@string/guest_banner_title"
            android:textColor="@color/violet"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvGuestBannerDays"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:alpha="0.75"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:background="@drawable/shape_r12"
        android:backgroundTint="@color/plum"
        android:fontFamily="@font/readex_pro_semibold"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/guest_banner_action"
        android:textColor="@color/on_plum"
        android:textSize="12sp" />
</LinearLayout>
