<?xml version="1.0" encoding="utf-8"?>
<!-- إشعار واحد: أيقونة بلون النوع، العنوان، النص، أزرار (واتساب / عرض الحساب)، الوقت، ونقطة "مش مقروء". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/notifCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/shape_r18"
    android:backgroundTint="@color/surface"
    android:elevation="2dp"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="horizontal"
    android:padding="14dp">

    <FrameLayout
        android:id="@+id/notifIconBox"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/shape_r16">

        <ImageView
            android:id="@+id/notifIcon"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNotifTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/readex_pro_semibold"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvNotifBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingMultiplier="1.25"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/notifActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNotifWhatsApp"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/notif_action_whatsapp"
                android:textColor="@color/on_plum"
                android:textSize="12sp"
                app:backgroundTint="@color/plum"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_chat"
                app:iconSize="15dp"
                app:iconTint="@color/lavender" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNotifOpen"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/notif_action_open"
                android:textColor="@color/violet"
                android:textSize="12sp"
                app:backgroundTint="@color/lavender_soft"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvNotifTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <View
        android:id="@+id/notifUnreadDot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/shape_circle"
        android:backgroundTint="@color/violet" />
</LinearLayout>
